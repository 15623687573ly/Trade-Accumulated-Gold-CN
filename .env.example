# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会提交）

# 微信推送，二选一（都填时优先 PushPlus）
PUSHPLUS_TOKEN=          # https://www.pushplus.plus 微信扫码登录后获取，免费额度较大
SERVERCHAN_SENDKEY=      # https://sct.ftqq.com 微信扫码获取，免费版每天条数很少

# AI 消息面分析：有 API key 用 API；没有则自动复用本机已登录的 Claude Code（claude -p，计入订阅用量）
ANTHROPIC_API_KEY=
# GOLD_AI_BACKEND=auto                    # Claude 分析师后端：auto / api / claude_code
# GOLD_AI_ANALYSTS=claude,codex           # 同一轮并发判断的 AI（Codex 复用本机已登录的 codex CLI，计入 ChatGPT 订阅用量）
# GOLD_AI_STRATEGY_SOURCE=claude          # 策略用谁的判断：claude / codex / consensus（两者方向一致才采用）
# GOLD_CODEX_MODEL=                       # 留空用 Codex 默认模型
# GOLD_AI_MAX_BUDGET_USD=3                # claude_code 单次调用上限（按官网价折算）
# GOLD_AI_MODEL=claude-opus-5-5
# GOLD_AI_SCHEDULE=08:40,20:45           # 工作日定时分析（北京时间）：开盘前 + 美国数据公布后；1 小时异动 >1% 另行触发
# GOLD_AI_VIEW_MAX_AGE_HOURS=13          # 短线用的 AI 判断有效期
# AI 主导账户（只作用于 +AI 账户，原版账户保持纯规则作对照）
# GOLD_AI_SHORT_ENTRY_P=0.50              # 短线+AI：3 日上涨概率达到此值才做多
# GOLD_AI_SHORT_EDGE=0.15                 # 且上涨概率比下跌概率高出此值
# GOLD_AI_SHORT_EXIT_P=0.50               # 3 日下跌概率达到此值则持仓离场
# GOLD_AI_LONG_BUY_EDGE=0.10              # AI 中长线：3 个月涨跌概率差 ≥ 此值建仓
# GOLD_AI_LONG_REDUCE_EDGE=-0.10          # ≤ 此值减仓一半
# GOLD_AI_LONG_EXIT_EDGE=-0.25            # ≤ 此值清仓
# GOLD_AI_LONG_STOP_LOSS=0.12             # 风控：亏损超过此比例清仓
# GOLD_AI_DCA_MAX_MULT=2.5                # AI 定投：每月金额最多为基础额的倍数
# GOLD_JIN10_ENABLED=1                    # 金十数据快讯（金十网页版公开接口，非官方 API）
# GOLD_JIN10_AI_DAILY_CAP=4               # 每天最多因金十重要快讯触发 AI 的次数
# GOLD_AI_EVENT_DELAY_MINUTES=10         # 美国重要数据公布后多久加跑 AI
# GOLD_AI_MAX_SEARCHES=2                  # 每次分析最多联网搜索次数（日历、宏观行情、金十快讯已由程序提供）

# 网页看板（monitor.web）
# GOLD_WEB_HOST=127.0.0.1               # 默认只允许本机访问；改为 0.0.0.0 对外时必须设置密码
# GOLD_WEB_PORT=8080
# GOLD_WEB_PASSWORD=                     # 至少 12 位；浏览器弹窗登录（用户名任意）

# 境外数据源代理（默认本机 Clash；设为空则直连）
# GOLD_TRADING_HTTP_PROXY=http://127.0.0.1:7890

# 可选调参（括号内为默认值）
# GOLD_MONITOR_STRATEGIES=hold,dca,dca_smart,position,dca_smart_ai,position_ai,short  # 同时运行的模拟盘策略
# GOLD_MONITOR_ACCOUNT_BUDGET=100000      # 每个日线策略账户的虚拟本金（元）
# GOLD_MONITOR_TICK_SECONDS=60            # 每轮间隔秒数
# GOLD_MONITOR_BANK_REFRESH_MINUTES=20    # 银行页面（Chromium）校准间隔
# GOLD_MONITOR_SELL_FEE_RATE=0.004        # 卖出手续费率（浙商/民生均 0.4%）
# GOLD_MONITOR_SPREAD_CNY=0               # 买卖价差（两家均为单一报价）
# GOLD_MONITOR_PAPER_BANK=zheshang        # 模拟盘银行：zheshang / minsheng
# GOLD_MONITOR_PAPER_GRAMS=10             # 模拟盘每笔克数
# GOLD_MONITOR_LEVEL_TOUCH_USD=3          # 距点位多少美元算「触及」
# GOLD_MONITOR_MOVE_WINDOW_MINUTES=30     # 价格异动窗口（分钟），触发提醒并加跑 AI
# GOLD_MONITOR_MOVE_PCT=0.6               # 价格异动阈值 %
# GOLD_MONITOR_ALERT_COOLDOWN_MINUTES=60  # 同类提醒冷却
# GOLD_MONITOR_DIGEST_HOURS=9,20          # 每日定时推送完整计划的北京时间整点
